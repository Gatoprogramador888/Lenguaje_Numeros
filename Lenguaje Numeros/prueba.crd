#programa correcto - prueba de todos los tipos y operaciones

#declaracion de enteros
# ==========================================================
# Programa de prueba con las nuevas palabras clave
# ==========================================================

# 1. Declaración de constantes y variables
const decimal : PI = 3.1416;
int : contador = 5, limite = 20, resultado = 0;
decimal : precio = 150.50, descuento = 12.25, total = 0.00;
dynamic : estado = 1;

# 2. Impresión de mensajes y cadenas interpoladas
print : $ "=== BIENVENIDO AL SISTEMA ===";
print : $ "Valor inicial del contador: {contador}";
print : $ "Constante PI: {PI}";

# 3. Operaciones matemáticas (incrementos, decrementos y asignaciones)
operation : contador++;
print : $ "Contador tras ++: {contador}";

operation : contador += 10;
print : $ "Contador tras += 10: {contador}";

operation : total = precio - descuento;
print : $ "Total calculado (precio - descuento): {total}";

operation : resultado = contador * 2 + limite / 4;
print : $ "Resultado de expresion combinada: {resultado}";

# 4. Entrada de datos por teclado (input)
print : $ "Ingrese un nuevo valor para la variable 'limite':";
input : limite;
print : $ "El nuevo limite ingresado es: {limite}";

# Recalcular con el nuevo limite
operation : resultado = limite + 5;
print : $ "Nuevo resultado (limite + 5): {resultado}";

# 5. Modificación de tipo dinamico y asignacion de null
operation : estado = 99.9;
print : $ "Variable dinamica actualizada a decimal: {estado}";

operation : estado = null;
print : $ "Se ha asignado 'null' a la variable estado.";

print : $ "=== FIN DEL PROGRAMA ===";
