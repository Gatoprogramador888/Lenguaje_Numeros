#programa correcto - prueba de todos los tipos y operaciones

#declaracion de enteros
Entero : a = 10, b = -5, c = 0;

#declaracion de decimales
Decimal : x = 3.14, y = -2.5, z = 0.0, prueba = 0.0;

#declaracion de dinamicos
Dinamico : d1 = 1, d2 = -1.5, d3 = 100;

#imprimir texto literal
Imprimir : $"--- Valores iniciales ---";
Imprimir : $ "a = {a}";
Imprimir : $ "b = {b}";
Imprimir : $ "c = {c}";
Imprimir : $ "x = {x}";
Imprimir : $ "y = {y}";
Imprimir : $ "d1 = {d1}";
Imprimir : $ "d2 = {d2}";

#Prueba definitiva
Operacion : prueba = 0.1 + 0.2;
Imprimir : $ "0.1 + 0.2 = {prueba}"; 

#operaciones entero + entero
Operacion : c = a + b;
Imprimir : $ "a + b = {c}";

Operacion : c = a - b;
Imprimir : $ "a - b = {c}";

Operacion : c = a * b;
Imprimir : $ "a * b = {c}";

Operacion : c = a / b;
Imprimir : $ "a / b = {c}";

#operaciones decimal + decimal
Operacion : z = x + y;
Imprimir : $ "x + y = {z}";

Operacion : z = x - y;
Imprimir : $ "x - y = {z}";

Operacion : z = x * y;
Imprimir : $ "x * y = {z}";

Operacion : z = x / y;
Imprimir : $ "x / y = {z}";

#operaciones mixtas entero + dinamico
Operacion : c = a + d2;
Imprimir : $ "a + d2 (entero destino) = {c}";

Operacion : d3 = b + x;
Imprimir : $ "b + x (dinamico destino) = {d3}";

#operaciones con negativos
Operacion : c = b * b;
Imprimir : $ "b * b = {c}";

Operacion : z = y * y;
Imprimir : $ "y * y = {z}";

Operacion : c = b * a;
Imprimir : $ "b * a = {c}";

#pedir valores
Imprimir : $ "Escriba un nuevo valor para a";
Pedir : a;
Imprimir : $ "nuevo valor de a = {a}";

Imprimir : $ "Escriba un nuevo valor para x";
Pedir : x;
Imprimir : $ "nuevo valor de x = {x}";

#operacion con valor pedido
Operacion : c = a + b;
Imprimir : $ "nuevo a + b = {c}";
